# ---------------------------------------------------------------------------
# DeepRecall configuration. Copy to `.env` and fill in.
# In GitHub Actions these are supplied as repository secrets instead.
# ---------------------------------------------------------------------------

# --- Notion ---------------------------------------------------------------
# Internal integration token: https://www.notion.so/my-integrations  (ntn_...)
# Remember to "Connect" the integration to the pages/databases you want read.
NOTION_TOKEN=

# Optional. If set, only pages inside this database are ingested.
# Leave empty to search every page the integration can see.
NOTION_DATABASE_ID=

# Optional. Comma-separated page IDs to ingest explicitly, regardless of when
# they were last edited. Useful for backfilling one big note.
NOTION_PAGE_IDS=

# Only ingest pages edited within this many hours (default 24).
INGEST_LOOKBACK_HOURS=24

# --- LLM synthesis --------------------------------------------------------
# "gemini" or "groq"
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Telegram -------------------------------------------------------------
# Create a bot with @BotFather, then get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Local paths / behaviour ---------------------------------------------
# Where flashcards live. Under the split layout (public code repo, private
# vault repo) this is where you clone the private vault repo to. Relative
# paths resolve against the project root; absolute paths work too.
VAULT_DIR=vault

# Max cards pushed in a single --notify run (keeps the daily session finite).
MAX_CARDS_PER_SESSION=15

# Commit + push vault changes after a rating. Set to false for local testing.
GIT_AUTO_COMMIT=true
